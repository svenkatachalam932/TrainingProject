{
  "name": "conduit-playwright-ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI-only Playwright automation for the Conduit application",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.8.1",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.3"
  }
}
